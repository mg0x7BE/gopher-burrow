<!doctype html>
<html lang="pl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Gopher Burrow Preview</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
<style>
  :root {
{{- range $name, $hex := .Palette}}
    --{{$name}}: #{{$hex}};
{{- end}}
  }

  * { box-sizing: border-box; }
  body {
    margin: 0;
    padding: 24px;
    background: var(--void);
    color: var(--fg);
    font: 15px/1.5 system-ui, "Segoe UI", sans-serif;
  }
  h1 { font-size: 18px; font-weight: 600; margin: 0 0 4px; }
  .sub { color: var(--punct); margin: 0 0 20px; }
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 16px; align-items: start; max-width: 1400px; }
  @media (max-width: 1000px) { .layout { grid-template-columns: minmax(0, 1fr); } }
  .island { background: var(--island); border-radius: 20px; padding: 16px; }

  .code { overflow-x: auto; padding: 8px 0; }
  pre {
    margin: 0; font-family: "JetBrains Mono", monospace; font-size: 15px; line-height: 1.65;
    tab-size: 4; color: var(--fg); font-variant-ligatures: none;
  }
  .line { display: block; padding-right: 16px; }
  .line.caret { background: var(--caret-row); }
  .ln { display: inline-block; width: 3.2em; padding-right: 1.4em; text-align: right; color: var(--line-number); user-select: none; }
  .caret .ln { color: var(--line-number-active); }

  .k { color: var(--lavender); }
  .f { color: var(--blue); font-weight: 700; }
  .c { color: var(--blue); }
  .t { color: var(--turquoise); }
  .td { color: var(--turquoise); font-weight: 700; }
  .bt { color: var(--turquoise); font-style: italic; }
  .bf { color: var(--blue); font-style: italic; }
  .bc { color: var(--salmon); }
  .n { color: var(--rose); }
  .p { color: var(--turquoise); }
  .s { color: var(--cream); }
  .e { color: var(--gold); }
  .num { color: var(--peach); }
  .cm { color: var(--comment); font-style: italic; }
  .cr { color: var(--comment-ref); }
  .fd { color: var(--periwinkle); }
  .rv { font-style: italic; }
  .cn { color: var(--lilac); font-style: italic; }
  .o { color: var(--operator); }
  .pu { color: var(--punct); }
  .pr, .br, .bk { color: var(--gold); }
  .tk { color: var(--tag-key); }
  .sh { text-decoration: underline dotted var(--salmon); text-underline-offset: 4px; }

  .legend h2 { font-size: 15px; font-weight: 600; margin: 0 0 12px; }
  .legend ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .legend li { display: grid; grid-template-columns: 14px 1fr; gap: 10px; align-items: center; font-size: 14px; }
  .sw { width: 14px; height: 14px; border-radius: 4px; }
  .legend code { font-family: "JetBrains Mono", monospace; font-variant-ligatures: none; font-size: 13px; color: var(--punct); }
</style>
</head>
<body>
<h1>Gopher Burrow</h1>
<p class="sub">Generated from palette.json by go run ./cmd/build. Editor island on the black window gap, caret row on line 42.</p>

<div class="layout">
  <div class="island code"><pre id="code"><span class="k">package</span> main

<span class="k">import</span> <span class="pr">(</span>
	<span class="s">"fmt"</span>
	<span class="s">"os"</span>
	<span class="s">"path/filepath"</span>
	<span class="s">"strings"</span>
<span class="pr">)</span>

<span class="cm">// <span class="cr">maxWidth</span> is the widest screenshot we keep as is.</span>
<span class="k">const</span> <span class="cn">maxWidth</span> <span class="o">=</span> <span class="num">320</span>

<span class="k">type</span> <span class="td">Image</span> <span class="k">struct</span> <span class="br">{</span>
	<span class="fd">Path</span>  <span class="bt">string</span> <span class="s">`</span><span class="tk">json</span><span class="pu">:</span><span class="s">"path"`</span>
	<span class="fd">Width</span> <span class="bt">int</span>    <span class="s">`</span><span class="tk">json</span><span class="pu">:</span><span class="s">"width"`</span>
	<span class="fd">Bytes</span> <span class="bt">int64</span>  <span class="s">`</span><span class="tk">json</span><span class="pu">:</span><span class="s">"bytes"`</span>
<span class="br">}</span>

<span class="k">type</span> <span class="td">Store</span> <span class="k">interface</span> <span class="br">{</span>
	<span class="f">Save</span><span class="pr">(</span>img <span class="t">Image</span><span class="pr">)</span> <span class="bt">error</span>
<span class="br">}</span>

<span class="cm">// <span class="cr">Scale</span> returns the ratio that fits the image into <span class="cr">maxWidth</span>.</span>
<span class="k">func</span> <span class="pr">(</span><span class="rv">img</span> <span class="o">*</span><span class="t">Image</span><span class="pr">)</span> <span class="f">Scale</span><span class="pr">()</span> <span class="bt">float64</span> <span class="br">{</span>
	<span class="k">if</span> <span class="rv">img</span><span class="pu">.</span><span class="fd">Width</span> <span class="o">&lt;=</span> <span class="cn">maxWidth</span> <span class="br">{</span>
		<span class="k">return</span> <span class="num">1.0</span>
	<span class="br">}</span>
	<span class="k">return</span> <span class="bt">float64</span><span class="pr">(</span><span class="cn">maxWidth</span><span class="pr">)</span> <span class="o">/</span> <span class="bt">float64</span><span class="pr">(</span><span class="rv">img</span><span class="pu">.</span><span class="fd">Width</span><span class="pr">)</span>
<span class="br">}</span>

<span class="k">func</span> <span class="f">collect</span><span class="pr">(</span>dir <span class="bt">string</span><span class="pu">,</span> verbose <span class="bt">bool</span><span class="pr">)</span> <span class="pr">(</span><span class="bk">[]</span><span class="t">Image</span><span class="pu">,</span> <span class="bt">error</span><span class="pr">)</span> <span class="br">{</span>
	entries<span class="pu">,</span> err <span class="o">:=</span> <span class="p">os</span><span class="pu">.</span><span class="c">ReadDir</span><span class="pr">(</span>dir<span class="pr">)</span>
	<span class="k">if</span> err <span class="o">!=</span> <span class="n">nil</span> <span class="br">{</span>
		<span class="k">return</span> <span class="n">nil</span><span class="pu">,</span> <span class="p">fmt</span><span class="pu">.</span><span class="c">Errorf</span><span class="pr">(</span><span class="s">"read %s: %w"</span><span class="pu">,</span> dir<span class="pu">,</span> err<span class="pr">)</span>
	<span class="br">}</span>
	<span class="k">var</span> images <span class="bk">[]</span><span class="t">Image</span>
	<span class="k">for</span> i<span class="pu">,</span> entry <span class="o">:=</span> <span class="k">range</span> entries <span class="br">{</span>
		name <span class="o">:=</span> entry<span class="pu">.</span><span class="c">Name</span><span class="pr">()</span>
		<span class="k">if</span> entry<span class="pu">.</span><span class="c">IsDir</span><span class="pr">()</span> <span class="o">||</span> <span class="p">strings</span><span class="pu">.</span><span class="c">HasPrefix</span><span class="pr">(</span>name<span class="pu">,</span> <span class="s">"."</span><span class="pr">)</span> <span class="br">{</span>
			<span class="k">continue</span>
		<span class="br">}</span>
		info<span class="pu">,</span> <span class="sh">err</span> <span class="o">:=</span> entry<span class="pu">.</span><span class="c">Info</span><span class="pr">()</span>
		<span class="k">if</span> <span class="sh">err</span> <span class="o">!=</span> <span class="n">nil</span> <span class="br">{</span>
			<span class="k">return</span> <span class="n">nil</span><span class="pu">,</span> <span class="sh">err</span>
		<span class="br">}</span>
		images <span class="o">=</span> <span class="bf">append</span><span class="pr">(</span>images<span class="pu">,</span> <span class="t">Image</span><span class="br">{</span><span class="fd">Path</span><span class="pu">:</span> <span class="p">filepath</span><span class="pu">.</span><span class="c">Join</span><span class="pr">(</span>dir<span class="pu">,</span> name<span class="pr">)</span><span class="pu">,</span> <span class="fd">Bytes</span><span class="pu">:</span> info<span class="pu">.</span><span class="c">Size</span><span class="pr">()</span><span class="br">}</span><span class="pr">)</span>
		<span class="k">if</span> verbose <span class="br">{</span>
			<span class="p">fmt</span><span class="pu">.</span><span class="c">Printf</span><span class="pr">(</span><span class="s">"%d: %s<span class="e">\n</span>"</span><span class="pu">,</span> i<span class="pu">,</span> name<span class="pr">)</span>
		<span class="br">}</span>
	<span class="br">}</span>
	<span class="k">return</span> images<span class="pu">,</span> <span class="n">nil</span>
<span class="br">}</span>

<span class="k">func</span> <span class="f">main</span><span class="pr">()</span> <span class="br">{</span>
	images<span class="pu">,</span> err <span class="o">:=</span> <span class="c">collect</span><span class="pr">(</span><span class="s">"."</span><span class="pu">,</span> <span class="bc">true</span><span class="pr">)</span>
	<span class="k">if</span> err <span class="o">!=</span> <span class="n">nil</span> <span class="br">{</span>
		<span class="p">fmt</span><span class="pu">.</span><span class="c">Fprintln</span><span class="pr">(</span><span class="p">os</span><span class="pu">.</span>Stderr<span class="pu">,</span> err<span class="pr">)</span>
		<span class="p">os</span><span class="pu">.</span><span class="c">Exit</span><span class="pr">(</span><span class="num">1</span><span class="pr">)</span>
	<span class="br">}</span>
	<span class="p">fmt</span><span class="pu">.</span><span class="c">Println</span><span class="pr">(</span><span class="bf">len</span><span class="pr">(</span>images<span class="pr">)</span><span class="pu">,</span> <span class="s">"images"</span><span class="pr">)</span>
<span class="br">}</span></pre></div>

  <aside class="island legend">
    <h2>Palette</h2>
    <ul>
      <li><span class="sw" style="background:var(--lavender)"></span><span>keywords <code>func if for</code></span></li>
      <li><span class="sw" style="background:var(--blue)"></span><span>functions and methods, declarations bold</span></li>
      <li><span class="sw" style="background:var(--turquoise)"></span><span>types and packages, built-in types italic</span></li>
      <li><span class="sw" style="background:var(--periwinkle)"></span><span>struct fields</span></li>
      <li><span class="sw" style="background:var(--lilac)"></span><span>constants <code>maxWidth</code></span></li>
      <li><span class="sw" style="background:var(--fg)"></span><span>variables, receivers italic</span></li>
      <li><span class="sw" style="background:var(--cream)"></span><span>strings</span></li>
      <li><span class="sw" style="background:var(--peach)"></span><span>numbers</span></li>
      <li><span class="sw" style="background:var(--salmon)"></span><span><code>true false iota</code></span></li>
      <li><span class="sw" style="background:var(--rose)"></span><span><code>nil</code></span></li>
      <li><span class="sw" style="background:var(--gold)"></span><span>brackets, escapes <code>\n</code></span></li>
      <li><span class="sw" style="background:var(--operator)"></span><span>operators <code>:= != ||</code></span></li>
      <li><span class="sw" style="background:var(--punct)"></span><span>dots and commas</span></li>
      <li><span class="sw" style="background:var(--comment)"></span><span>comments</span></li>
      <li><span class="sw" style="background:var(--salmon)"></span><span>dotted underline: shadowed <code>err</code></span></li>
    </ul>
  </aside>
</div>

<script>
  const CARET_LINE = 42;
  const code = document.getElementById("code");
  code.innerHTML = code.innerHTML.split("\n").map((html, i) =>
    `<span class="line${i + 1 === CARET_LINE ? " caret" : ""}"><span class="ln">${i + 1}</span>${html || " "}</span>`
  ).join("");
</script>
</body>
</html>
