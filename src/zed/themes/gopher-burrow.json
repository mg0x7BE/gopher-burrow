{
  "name": "Gopher Burrow",
  "author": "mg0x7BE",
  "themes": [
    {
      "name": "Gopher Burrow",
      "appearance": "dark",
      "style": {
        "background": "#$void",
        "background.appearance": "opaque",

        "border": "#$void",
        "border.variant": "#$guide",
        "border.focused": "#$accent-80",
        "border.selected": "#$tab-active",
        "border.transparent": "#00000000",
        "border.disabled": "#$guide",
        "pane_group.border": "#$void",
        "pane.focused_border": "#$tab-active",

        "surface.background": "#$island",
        "elevated_surface.background": "#$raised",
        "panel.background": "#$island",
        "panel.indent_guide": "#$guide",
        "panel.indent_guide_active": "#$guide-active",
        "panel.indent_guide_hover": "#$guide-active",
        "panel.focused_border": "#$accent-40",
        "panel.overlay_background": "#$raised",
        "panel.overlay_hover": "#$hint",
        "title_bar.background": "#$void",
        "title_bar.inactive_background": "#$void",
        "status_bar.background": "#$void",
        "toolbar.background": "#$island",
        "tab_bar.background": "#$island",
        "tab.inactive_background": "#$island",
        "tab.active_background": "#$tab-active",

        "element.background": "#$raised",
        "element.hover": "#$hint",
        "element.active": "#$accent-40",
        "element.selected": "#$accent-40",
        "element.selection_background": "#$selection",
        "element.disabled": "#$raised",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "#$hint",
        "ghost_element.active": "#$accent-40",
        "ghost_element.selected": "#$accent-40",
        "ghost_element.disabled": "#00000000",
        "drop_target.background": "#$accent-30",
        "drop_target.border": "#$accent-60",

        "text": "#$fg",
        "text.muted": "#$line-number-active",
        "text.placeholder": "#$line-number",
        "text.disabled": "#$line-number",
        "text.accent": "#$turquoise",
        "icon": "#$fg",
        "icon.muted": "#$line-number-active",
        "icon.disabled": "#$line-number",
        "icon.placeholder": "#$line-number",
        "icon.accent": "#$lavender",
        "link_text.hover": "#$blue",

        "scrollbar.thumb.background": "#$border-strong",
        "scrollbar.thumb.hover_background": "#$guide-active",
        "scrollbar.thumb.active_background": "#$accent-60",
        "scrollbar.thumb.border": "#00000000",
        "scrollbar.track.background": "#00000000",
        "scrollbar.track.border": "#00000000",
        "minimap.thumb.background": "#$border-strong",
        "minimap.thumb.hover_background": "#$guide-active",
        "minimap.thumb.active_background": "#$accent-60",
        "minimap.thumb.border": "#00000000",

        "search.match_background": "#$search",
        "search.active_match_background": "#$accent-70",

        "editor.foreground": "#$fg",
        "editor.background": "#$island",
        "editor.gutter.background": "#$island",
        "editor.subheader.background": "#$raised",
        "editor.active_line.background": "#$caret-row",
        "editor.highlighted_line.background": "#$hint",
        "editor.line_number": "#$line-number",
        "editor.active_line_number": "#$line-number-active",
        "editor.hover_line_number": "#$line-number-active",
        "editor.invisible": "#$guide-active",
        "editor.wrap_guide": "#$guide",
        "editor.active_wrap_guide": "#$guide-active",
        "editor.indent_guide": "#$guide",
        "editor.indent_guide_active": "#$guide-active",
        "editor.document_highlight.read_background": "#$guide",
        "editor.document_highlight.write_background": "#$ident-write",
        "editor.document_highlight.bracket_background": "#$accent-40",
        "editor.diff_hunk.added.background": "#$diff-inserted",
        "editor.diff_hunk.deleted.background": "#$diff-deleted",
        "editor.diff_hunk.added.hollow_background": "#$diff-inserted",
        "editor.diff_hunk.added.hollow_border": "#$diff-inserted-mark",
        "editor.diff_hunk.deleted.hollow_background": "#$diff-deleted",
        "editor.diff_hunk.deleted.hollow_border": "#$diff-deleted-mark",
        "editor.code_lens.foreground": "#$comment",
        "editor.debugger_active_line.background": "#$accent-60",
        "debugger.accent": "#$diff-deleted-mark",

        "version_control.added": "#$diff-inserted-mark",
        "version_control.modified": "#$blue-dim",
        "version_control.deleted": "#$diff-deleted-mark",
        "version_control.renamed": "#$blue",
        "version_control.conflict": "#$diff-conflict-mark",
        "version_control.ignored": "#$line-number",
        "version_control.conflict_marker.ours": "#$diff-inserted",
        "version_control.conflict_marker.theirs": "#$diff-modified",
        "version_control.word_added": "#$diff-inserted-word",
        "version_control.word_deleted": "#$diff-deleted-word",

        "created": "#$diff-inserted-mark",
        "created.background": "#$diff-inserted",
        "created.border": "#$diff-inserted-mark",
        "modified": "#$blue",
        "modified.background": "#$diff-modified",
        "modified.border": "#$blue-dim",
        "deleted": "#$diff-deleted-mark",
        "deleted.background": "#$diff-deleted",
        "deleted.border": "#$diff-deleted-mark",
        "renamed": "#$blue",
        "renamed.background": "#$diff-modified",
        "renamed.border": "#$blue-dim",
        "conflict": "#$diff-conflict-mark",
        "conflict.background": "#$diff-conflict",
        "conflict.border": "#$diff-conflict-mark",
        "error": "#$diff-deleted-mark",
        "error.background": "#$diff-deleted",
        "error.border": "#$diff-deleted-mark",
        "warning": "#$gold",
        "warning.background": "#$search",
        "warning.border": "#$gold",
        "info": "#$blue",
        "info.background": "#$diff-modified",
        "info.border": "#$blue-dim",
        "success": "#$green",
        "success.background": "#$diff-inserted",
        "success.border": "#$diff-inserted-mark",
        "hint": "#$comment-ref",
        "hint.background": "#$hint",
        "hint.border": "#$guide",
        "predictive": "#$comment",
        "predictive.background": "#$raised",
        "predictive.border": "#$guide",
        "ignored": "#$line-number",
        "ignored.background": "#$raised",
        "ignored.border": "#$guide",
        "hidden": "#$line-number",
        "hidden.background": "#$raised",
        "hidden.border": "#$guide",
        "unreachable": "#$comment",
        "unreachable.background": "#$raised",
        "unreachable.border": "#$guide",

        "terminal.background": "#$island",
        "terminal.foreground": "#$fg",
        "terminal.bright_foreground": "#$fg",
        "terminal.dim_foreground": "#$comment",
        "terminal.ansi.background": "#$island",
        "terminal.ansi.black": "#$border-strong",
        "terminal.ansi.bright_black": "#$comment",
        "terminal.ansi.dim_black": "#$hint",
        "terminal.ansi.red": "#$diff-deleted-mark",
        "terminal.ansi.bright_red": "#$salmon",
        "terminal.ansi.dim_red": "#$diff-deleted-mark",
        "terminal.ansi.green": "#$diff-inserted-mark",
        "terminal.ansi.bright_green": "#$green",
        "terminal.ansi.dim_green": "#$diff-inserted-mark",
        "terminal.ansi.yellow": "#$gold",
        "terminal.ansi.bright_yellow": "#$cream",
        "terminal.ansi.dim_yellow": "#$diff-conflict-mark",
        "terminal.ansi.blue": "#$blue-dim",
        "terminal.ansi.bright_blue": "#$blue",
        "terminal.ansi.dim_blue": "#$blue-dim",
        "terminal.ansi.magenta": "#$orchid",
        "terminal.ansi.bright_magenta": "#$lavender",
        "terminal.ansi.dim_magenta": "#$accent-70",
        "terminal.ansi.cyan": "#$turquoise",
        "terminal.ansi.bright_cyan": "#$turquoise",
        "terminal.ansi.dim_cyan": "#$blue-dim",
        "terminal.ansi.white": "#$line-number-active",
        "terminal.ansi.bright_white": "#$fg",
        "terminal.ansi.dim_white": "#$line-number",

        "players": [
          { "cursor": "#$fg", "background": "#$accent-80", "selection": "#$selection" },
          { "cursor": "#$blue", "background": "#$blue", "selection": "#$diff-modified" },
          { "cursor": "#$green", "background": "#$green", "selection": "#$diff-inserted" },
          { "cursor": "#$peach", "background": "#$peach", "selection": "#$diff-conflict" },
          { "cursor": "#$salmon", "background": "#$salmon", "selection": "#$diff-deleted" },
          { "cursor": "#$turquoise", "background": "#$turquoise", "selection": "#$hint" },
          { "cursor": "#$gold", "background": "#$gold", "selection": "#$search" },
          { "cursor": "#$orchid", "background": "#$orchid", "selection": "#$branch-row" }
        ],

        "accents": ["#$gold", "#$lavender", "#$blue", "#$turquoise", "#$peach", "#$orchid"],

        "syntax": {
          "attribute": { "color": "#$periwinkle" },
          "boolean": { "color": "#$salmon" },
          "comment": { "color": "#$comment", "font_style": "italic" },
          "comment.doc": { "color": "#$comment", "font_style": "italic" },
          "concept": { "color": "#$turquoise" },
          "constant": { "color": "#$lilac", "font_style": "italic" },
          "constant.builtin": { "color": "#$rose", "font_style": "normal" },
          "constructor": { "color": "#$turquoise" },
          "diff.minus": { "color": "#$diff-deleted-mark" },
          "diff.plus": { "color": "#$diff-inserted-mark" },
          "embedded": { "color": "#$fg" },
          "emphasis": { "color": "#$fg", "font_style": "italic" },
          "emphasis.strong": { "color": "#$fg", "font_weight": 700 },
          "enum": { "color": "#$turquoise" },
          "function": { "color": "#$blue" },
          "function.builtin": { "color": "#$blue", "font_style": "italic" },
          "function.decorator": { "color": "#$orchid" },
          "function.definition": { "color": "#$blue", "font_weight": 700 },
          "function.kwargs": { "color": "#$periwinkle" },
          "function.method.constructor": { "color": "#$blue", "font_weight": 700 },
          "hint": { "color": "#$line-number" },
          "keyword": { "color": "#$lavender" },
          "label": { "color": "#$lavender", "font_style": "italic" },
          "lifetime": { "color": "#$turquoise", "font_style": "italic" },
          "link_text": { "color": "#$blue" },
          "link_uri": { "color": "#$punct" },
          "namespace": { "color": "#$turquoise" },
          "number": { "color": "#$peach" },
          "operator": { "color": "#$operator" },
          "predictive": { "color": "#$comment", "font_style": "italic" },
          "preproc": { "color": "#$lilac", "font_style": "italic" },
          "primary": { "color": "#$fg" },
          "property": { "color": "#$periwinkle" },
          "punctuation": { "color": "#$punct" },
          "punctuation.bracket": { "color": "#$gold" },
          "punctuation.delimiter": { "color": "#$punct" },
          "punctuation.list_marker": { "color": "#$lavender" },
          "punctuation.markup": { "color": "#$punct" },
          "punctuation.special": { "color": "#$gold" },
          "selector": { "color": "#$turquoise" },
          "selector.pseudo": { "color": "#$lavender", "font_style": "italic" },
          "string": { "color": "#$cream" },
          "string.escape": { "color": "#$gold" },
          "string.regex": { "color": "#$cream" },
          "string.special": { "color": "#$gold" },
          "string.special.symbol": { "color": "#$lilac" },
          "tag": { "color": "#$lavender" },
          "text.literal": { "color": "#$cream" },
          "title": { "color": "#$lavender", "font_weight": 700 },
          "type": { "color": "#$turquoise" },
          "type.builtin": { "color": "#$turquoise", "font_style": "italic" },
          "type.definition": { "color": "#$turquoise", "font_weight": 700 },
          "variable": { "color": "#$fg" },
          "variable.parameter": { "color": "#$fg" },
          "variable.special": { "color": "#$fg", "font_style": "italic" },
          "variant": { "color": "#$lilac", "font_style": "italic" }
        }
      }
    }
  ]
}
